;;(defwindow ram
;;  :monitor 0
;;  :geometry (geometry :y "80%":x "60%" :width "20%" :height "10%" ) 
;;  :stacking "overlay"
;;  (ram-widget))
;;

(defwindow clock
  :namespace "eww-blur"
  :monitor 0
  :geometry (geometry :width "20%" :height "10%" :anchor "center")
  :stacking "overlay"
  :visible true
  :exclusive false  
  (clock))

(defwindow ram :monitor 0 :geometry (geometry :width "15%" :height "15%" :x "60%" :y "80%") :stacking "overlay" :windowtype "normal" :wm-ignore false (ram_widget))


