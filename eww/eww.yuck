(defpoll title :interval "1s" `playerctl --player=spotify metadata --format '{{title}}'`)
(defpoll artist :interval "1s" `playerctl --player=spotify metadata --format '{{artist}}'`)


(defpoll ram-usage :interval "2s"
  `free -h | awk '/^Mem:/ {print $3 "/" $2}'`)


(deflisten ram-percent :initial "0"
  `while true; do free | awk '/^Mem:/ {print int($3/$2 * 100)}'; sleep 2; done`)


(defpoll ram_usage :interval "2s" `free | awk '/Mem:/ {printf "%.0f", ($3/$2)*100}'`)

(defpoll cover   :interval "1s"
"bash ~/eww-scripts/getsongcover.sh")

(defpoll lyrics   :interval "200ms"
"bash ~/eww-scripts/lyrics.sh")



(defpoll time :interval "1s" "date +%H:%M")
(defpoll date :interval "1s" "date +'%A, %d %B %Y'")

(defwidget clock []
  (box :orientation "vertical" :halign "center" :class "clock-box"
    (label :text time :class "clock-time")
    (label :text date :class "clock-date")))

(defwidget ram-widget []
  (box :class "widget-box"
       :orientation "h"
       :spacing 0
    (overlay
            (box :orientation "h"
           :spacing 5
           :class "ram-text-overlay"
        (label :text "RAM"
               :class "ram-label")
        (label :text ram-usage
               :class "ram-usage")))))


(defwidget music-widget []
    (box :class "music-widget" :orientation "h" :space-evenly false
    (box :class "cover" :halign "start" :valign "center"
    (image :path cover :image-width 160 :class "cover-img")
      )
    (box :orientation "horizontal" :halign "end" :class "song-info"
    (label :text title :class "song-title" :valign "center" :halign "end" :wrap true)
    (label :text "" :valign "center")
    (label :text artist :class "song-artist" :valign "center" :wrap true)
      )))



(deflisten workspaces :initial "[]" "bash ~/eww-scripts/get-workspaces.sh")
(deflisten current_workspace :initial "..." "bash ~/eww-scripts/get-active-workspace.sh")
(deflisten urgent_workspace :initial "..." "bash ~/eww-scripts/get-urgent-workspaces.sh")
(defwidget _workspaces []
  (eventbox :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${current_workspace}" :class "workspaces-widget"
    (box :space-evenly false :halign "center"
      (label :text "${workspaces}${current_workspace}${urgent_workspace}" :visible false)
      (for workspace in workspaces
        (eventbox :onclick "hyprctl dispatch workspace ${workspace.id}"
          (box :class "workspace-entry ${workspace.id == current_workspace ? "current" : ""} ${workspace.id == urgent_workspace ? "urgent" : ""} ${workspace.windows > 0 ? "occupied" : "empty" }"
            (label :text "${workspace.id}")
          )
        )
      )
    )
  )
)


(defwidget music-lyrics []
(label :text lyrics :class "song-lyrics"
))

(defwidget ram_widget [] (circular-progress :value ram_usage :start-at 75 :thickness 8 :class "ram-progress" (box :class "ram-content" :orientation "v" :space-evenly false (label :class "ram-icon" :text "RAM usage") (label :class "ram-percent" :text "${ram_usage}%"))))






;;--- Window Definition ---

(defwindow music-widget
  :monitor 0
  :geometry (geometry :x "20%" :y "10%" :width "20%" :height "10%" )
  :stacking "overlay"
  :exclusive false
  (music-widget)
)


(defwindow music-progress
  :monitor 0
  :geometry (geometry :x "20%" :y "20%" :width "20%" :height "5%" )
  :stacking "overlay"
  :exclusive false
  (music-position)
)



(defwindow clock
  :namespace "eww-blur"
  :monitor 0
  :geometry (geometry :width "20%" :height "10%" :anchor "center")
  :stacking "overlay"
  :visible true
  :exclusive false  
  (clock))

(defwindow ram :monitor 0 :geometry (geometry :width "15%" :height "15%" :x "60%" :y "80%") :stacking "overlay" :windowtype "normal" :wm-ignore false (ram_widget))



(defwindow ws-indicator
  :monitor 0
  :geometry (geometry :y "74.5%":x "60%" :width "15%" :height "5%" ) 
  :stacking "overlay"
  (_workspaces))




(defwindow music-lyrics
  :monitor 0
  :geometry (geometry :width "20%" :height "10%" :x "60%" :y "80")
  :stacking "overlay"
  :visible true
  :exclusive false  
  (music-lyrics))


